# Local or pooled Postgres connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Public base URL of the application.
APP_URL=http://localhost:3000
# At least 32 characters of random session-signing material.
SESSION_SECRET=replace-with-32-or-more-random-characters
# At least 32 characters of random quote-signing material.
QUOTE_SIGNING_SECRET=replace-with-a-different-32-or-more-random-characters
# PayPal environment selector: sandbox or live.
PAYPAL_ENV=sandbox
# PayPal REST application client identifier.
PAYPAL_CLIENT_ID=your-paypal-client-id
# PayPal REST application client secret.
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# PayPal webhook identifier.
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
# Optional local MCP smoke-test bearer. This is a placeholder, never a working pass.
AGENTSHELF_PASS_TOKEN=asp_replace-with-a-test-pass-token
SHOPPER_SMOKE_URL=http://localhost:3000
# Google Gemini API key for the primary language model.
GOOGLE_GENERATIVE_AI_API_KEY=your-google-generative-ai-api-key
# Groq API key for the fallback language model.
GROQ_API_KEY=your-groq-api-key
# Gemini model used for photo understanding and text improvement.
GEMINI_MODEL=gemini-3.5-flash
# Groq text model used when Gemini cannot improve a description.
GROQ_MODEL=openai/gpt-oss-120b
# PayPal email for the Maya demo shop.
PAYPAL_MERCHANT1_EMAIL=merchant-one@example.com
# PayPal email for the Lahore Threads demo shop.
PAYPAL_MERCHANT2_EMAIL=merchant-two@example.com
# Enables local demo-specific behavior when true.
DEMO_MODE=false
