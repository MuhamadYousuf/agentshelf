# Local or pooled Postgres connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Public base URL of the application.
APP_URL=http://localhost:3000
# At least 32 characters of random session-signing material.
SESSION_SECRET=replace-with-32-or-more-random-characters
# At least 32 characters of random quote-signing material.
QUOTE_SIGNING_SECRET=replace-with-a-different-32-or-more-random-characters
# PayPal environment selector: sandbox or live.
PAYPAL_ENV=sandbox
# PayPal REST application client identifier.
PAYPAL_CLIENT_ID=your-paypal-client-id
# PayPal REST application client secret.
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# PayPal webhook identifier.
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
# Google Gemini API key for the primary language model.
GOOGLE_GENERATIVE_AI_API_KEY=your-google-generative-ai-api-key
# Groq API key for the fallback language model.
GROQ_API_KEY=your-groq-api-key
# Enables local demo-specific behavior when true.
DEMO_MODE=false
